          "-ap-south-1"
         ]
        ]
       },
       {
        "Fn::Join": [
         "",
         [
          "cdk-hnb659fds-cfn-exec-role-",
          {
           "Ref": "AWS::AccountId"
          },
          "-ap-south-1"
         ]
        ]
       }
      ]
     }
    },
    "ExecutionRoleArn": {
     "Fn::GetAtt": [
      "BudgetsActionRoleCD1482F5",
      "Arn"
     ]
    },
    "NotificationType": "ACTUAL",
    "ResourceTags": [
     {
      "Key": "env",
      "Value": "shared"
     },
     {
      "Key": "managed-by",
      "Value": "cdk"
     },
     {
      "Key": "project",
      "Value": "task-organizer"
     }
    ],
    "Subscribers": [
     {
      "Address": {
       "Ref": "AlertEmail"
      },
      "Type": "EMAIL"
     }
    ]
   },
   "DependsOn": [
    "BudgetsActionPolicy168969C5"
   ],
   "Metadata": {
    "aws:cdk:path": "task-organizer-account-baseline/StopOnBudgetExceeded"
   }
